# Copy to .env and fill in. Never commit the real .env.

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False

# Comma separated
ALLOWED_HOSTS=tudominio.com,www.tudominio.com
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# Secret-ish admin path, must end with "/"
ADMIN_URL=admin/

# Paths on the server (defaults to the project folder when unset)
SQLITE_PATH=/srv/blog/data/db.sqlite3
MEDIA_ROOT=/srv/blog/media
STATIC_ROOT=/srv/blog/staticfiles

# Transactional email (e.g. Brevo: smtp-relay.brevo.com / Resend: smtp.resend.com)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nestor Bracho <no-reply@tudominio.com>
CONTACT_EMAIL=

# Personal details rendered on the site (kept out of the public repo)
OWNER_EMAIL=
OWNER_PHONE=
OWNER_LOCATION=

# Optional, only for blog/article_generation.py
OPENAI_API_KEY=
UNSPLASH_ACCESS_KEY=
